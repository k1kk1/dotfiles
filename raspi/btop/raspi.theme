# raspi 専用 btop テーマ: 黄緑のサイバーパンク（dotfiles の raspi ブランチで管理）
# ~/.config/btop/themes/raspi.theme にリンクされる

theme[main_bg]="#070A06"
theme[main_fg]="#C8F7A0"
theme[title]="#F0FFE0"
theme[hi_fg]="#B6FF3B"
theme[selected_bg]="#24391A"
theme[selected_fg]="#F0FFE0"
theme[inactive_fg]="#3D5230"
theme[graph_text]="#8FB573"
theme[meter_bg]="#16220F"
theme[proc_misc]="#5CFF7A"
theme[cpu_box]="#B6FF3B"
theme[mem_box]="#5CFF7A"
theme[net_box]="#3BFFD1"
theme[proc_box]="#6B8F3A"
theme[div_line]="#3D5230"

# グラフのグラデーション（低 → 中 → 高）
theme[temp_start]="#5CFF7A"
theme[temp_mid]="#FFD23B"
theme[temp_end]="#FF3B6B"
theme[cpu_start]="#5CFF7A"
theme[cpu_mid]="#B6FF3B"
theme[cpu_end]="#FF3B6B"
theme[free_start]="#3D5230"
theme[free_mid]="#6B8F3A"
theme[free_end]="#8FB573"
theme[cached_start]="#1F4D3A"
theme[cached_mid]="#3BD6A0"
theme[cached_end]="#8AFFE6"
theme[available_start]="#3D5230"
theme[available_mid]="#6B8F3A"
theme[available_end]="#B6FF3B"
theme[used_start]="#5CFF7A"
theme[used_mid]="#D4FF3B"
theme[used_end]="#FF3B6B"
theme[download_start]="#1F4D3A"
theme[download_mid]="#3BD6A0"
theme[download_end]="#3BFFD1"
theme[upload_start]="#3D5230"
theme[upload_mid]="#9DFF6E"
theme[upload_end]="#B6FF3B"
theme[process_start]="#5CFF7A"
theme[process_mid]="#B6FF3B"
theme[process_end]="#FF3B6B"
